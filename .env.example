# Required: your OpenAI-compatible API key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: custom base URL for OpenAI-compatible APIs (e.g. local, Azure, third-party)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: system prompt
# SYSTEM_MESSAGE=你是一个简洁的助手。

# Optional: enable streaming output for plain text (default: true)
# Set to "false" to disable streaming and print complete responses at once.
# Code blocks and markdown tables are always buffered and printed as a whole,
# regardless of this setting.
# OPENAI_STREAM=true
